{
  "name": "@little-nebulae/error",
  "version": "1.4.0",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "build": "tsdown",
    "try": "oxnode ./src/try.ts",
    "fmt": "oxfmt --disable-nested-config",
    "fmt:check": "oxfmt --check --disable-nested-config",
    "lint": "oxlint --disable-nested-config",
    "lint:fix": "oxlint --fix --disable-nested-config",
    "check": "pnpm run lint && pnpm run fmt:check",
    "fix": "pnpm run lint:fix && pnpm run fmt",
    "test": "vitest run"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@oxc-node/cli": "0.1.7",
    "@types/node": "26.6.5",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "publint": "0.3.25",
    "tsdown": "0.23.1",
    "type-fest": "5.10.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "type-fest": "^5.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "warn"
    }
  },
  "packageManager": "pnpm@12.14.0"
}
